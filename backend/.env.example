# Server
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# URL of the separately-deployed mobile controller app (e.g. Vercel). Baked into
# the HoloBox's QR code. Leave blank for same-origin/local setups.
MOBILE_APP_URL=
CORS_ORIGIN=*

# Video generation provider: fal | replicate | huggingface | mock
VIDEO_PROVIDER=mock

# Fal.ai (https://fal.ai) - pay-as-you-go image-to-video (Wan 2.2 / Kling), no free tier
FAL_API_KEY=
FAL_MODEL=fal-ai/wan-i2v

# Replicate (https://replicate.com) - minimax/video-01 (Hailuo) is in Replicate's
# "Try for Free" collection: limited free runs, no credit card required to start.
# https://replicate.com/collections/try-for-free
REPLICATE_API_TOKEN=
REPLICATE_MODEL=minimax/video-01

# Hugging Face Inference Providers (https://huggingface.co)
HF_API_KEY=
HF_MODEL=Wan-AI/Wan2.1-I2V-14B-480P

# Expiration (minutes)
SELFIE_TTL_MINUTES=30
VIDEO_TTL_MINUTES=1440
SESSION_TTL_MINUTES=60

# Upload limits
MAX_UPLOAD_MB=10
