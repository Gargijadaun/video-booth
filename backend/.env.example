# Server
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# URL of the separately-deployed mobile controller app (e.g. Vercel). Baked into
# the HoloBox's QR code. Leave blank for same-origin/local setups.
MOBILE_APP_URL=
CORS_ORIGIN=*

# Video generation provider: fal | replicate | huggingface | elevenlabs | mock
VIDEO_PROVIDER=mock

# Fal.ai (https://fal.ai) - pay-as-you-go, no free tier. Veo 3.1 is $0.20/s
# (audio off, 720p) - a 4s clip is $0.80. Higher quality/cost than Wan.
FAL_API_KEY=
FAL_MODEL=fal-ai/veo3.1/image-to-video

# Replicate (https://replicate.com) - minimax/video-01 (Hailuo) is in Replicate's
# "Try for Free" collection: limited free runs, no credit card required to start.
# https://replicate.com/collections/try-for-free
REPLICATE_API_TOKEN=
REPLICATE_MODEL=minimax/video-01

# Hugging Face Inference Providers (https://huggingface.co)
HF_API_KEY=
HF_MODEL=Wan-AI/Wan2.1-I2V-14B-480P

# ElevenLabs Flows Video API (https://elevenlabs.io) - requires a Pro plan or
# above. Wraps Google Veo 3.1 (and Bytedance Seedance models) behind
# ElevenLabs' own infrastructure. https://elevenlabs.io/docs/api-reference/flows/video/create
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=veo-3.1-generate-001

# OpenAI (https://platform.openai.com) - superseded by GEMINI_API_KEY below for
# the face-swap step (kept here in case it's useful again).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Google Gemini ("Nano Banana", https://aistudio.google.com) - used
# independently of VIDEO_PROVIDER for the template face-swap step
# (gemini-2.5-flash-image multi-image edit) whenever this key is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# Expiration (minutes)
SELFIE_TTL_MINUTES=30
VIDEO_TTL_MINUTES=1440
SESSION_TTL_MINUTES=60

# Upload limits
MAX_UPLOAD_MB=10
